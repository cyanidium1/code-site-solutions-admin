{
  "_notes": [
    "One entry per case-study site. `slug` MUST match the caseStudy.slug.current in Sanity",
    "so the uploader can match screenshots to the right document.",
    "`sections` are captured as cropped element screenshots (NOT full-page).",
    "Fill `selector` with a CSS selector for the block. Use the first matching element.",
    "If you don't know the selector yet, run `npm run case:inspect -- --site <slug>`",
    "to print candidate landmarks, then edit this file.",
    "`priority` controls cover-image pick order in the uploader (lower = preferred)."
  ],
  "viewports": {
    "desktop": {"width": 1440, "height": 900, "deviceScaleFactor": 2},
    "mobile": {"width": 390, "height": 844, "deviceScaleFactor": 3, "isMobile": true}
  },
  "cookieDismissSelectors": [
    "#onetrust-accept-btn-handler",
    "button[aria-label*='accept' i]",
    "button:has-text('Accept')",
    "button:has-text('Allow all')",
    "button:has-text('Прийняти')",
    "button:has-text('Погоджуюсь')",
    "[class*='cookie'] button",
    "[id*='cookie'] button"
  ],
