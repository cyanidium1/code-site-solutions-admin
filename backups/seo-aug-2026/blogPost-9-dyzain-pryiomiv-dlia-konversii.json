        "_key": "t20c3",
        "_type": "block",
        "children": [
          {
            "_key": "t20c1",
            "_type": "span",
            "marks": [
              "strong"
            ],
            "text": "Real photos instead of stock. "
          },
          {
            "_key": "t20c2",
            "_type": "span",
            "marks": [],
            "text": "Efedra: practitioner and room photos instead of stock smiles — part of the redesign that delivered 3.2× enquiries. Stock saves a day at the start and costs enquiries for years."
