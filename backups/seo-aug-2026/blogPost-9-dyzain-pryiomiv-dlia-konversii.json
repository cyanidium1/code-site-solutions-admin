            "_key": "t20by",
            "_type": "span",
            "marks": [
              "strong"
            ],
            "text": "The button where the user is ready. "
          },
          {
            "_key": "t20bz",
            "_type": "span",
            "marks": [],
            "text": "Not just the header: after the benefits, after the prices, after the reviews. Nobody should scroll back to say \"yes\"."
          }
        ],
        "level": 1,
        "listItem": "number",
        "markDefs": [],
        "style": "normal"
      },
