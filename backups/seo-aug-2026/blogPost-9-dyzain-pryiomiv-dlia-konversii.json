            "_type": "span",
            "marks": [
              "strong"
            ],
            "text": "Numbers instead of adjectives. "
          },
          {
            "_key": "t20c5",
            "_type": "span",
            "marks": [],
            "text": "\"Fast service\" is noise. \"We reply within 4 hours\" is a fact. Numbers read faster and stick longer."
          }
        ],
        "level": 1,
        "listItem": "number",
        "markDefs": [],
        "style": "normal"
      },
