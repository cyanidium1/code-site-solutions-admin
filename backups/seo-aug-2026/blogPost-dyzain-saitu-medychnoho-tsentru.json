        "_type": "block",
        "children": [
          {
            "_key": "mt08h",
            "_type": "span",
            "marks": [
              "strong"
            ],
            "text": "Real photos of practitioners and rooms. "
          },
          {
            "_key": "mt08i",
            "_type": "span",
            "marks": [],
            "text": "Stock reads instantly and works against you: \"if they hide their own doctors — what else are they hiding?\" Even tidy phone photos beat perfect stock."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
