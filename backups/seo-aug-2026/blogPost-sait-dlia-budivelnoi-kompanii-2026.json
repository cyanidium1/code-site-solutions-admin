      {
        "_key": "cw02p",
        "_type": "block",
        "children": [
          {
            "_key": "cw02q",
            "_type": "span",
            "marks": [],
            "text": "Construction has a high deal value: one renovation or build contract is worth thousands. A £3,500 website pays for itself with the first or second closed client. Few industries have that maths."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
      {
